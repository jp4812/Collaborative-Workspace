# Server Configuration
PORT=3000

# MongoDB Cloud / Local Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/collaborative_workspace_db?retryWrites=true&w=majority

# JWT Token Secret for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Enterprise Root Administrator Credentials (Optional)
ROOT_ADMIN_EMAIL=superadmin@admin.nexus.in
ROOT_ADMIN_PASSWORD=AdminRoot123!

# Email OTP & 2FA Configuration
OTP_SECRET=change-me-long-random-string
OTP_TTL_MINUTES=10
OTP_LOGIN_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nexus <no-reply@yourdomain.com>"

